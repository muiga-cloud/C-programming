#include <stdio.h>

int main() {
    float revenue[7];
    float total=0,average;
    
    int i;
    for(i=0;i<7;i++){
        printf("enter revenue for the day %d:",i+1);
        scanf("%f",&revenue[i]);

        total=total+revenue[i];  
    }

    printf("total weekly revenue is %.2f\n",total);
    printf("total average revenue is %.2f\n",average);
    
    return 0;
}
